# HTTP
HTTP_ADDR=:8080

# Postgres
POSTGRES_USER=passkey
POSTGRES_PASSWORD=passkey
POSTGRES_DB=passkey
DATABASE_URL=postgres://passkey:passkey@postgres:5432/passkey?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# WebAuthn relying party
RP_ID=localhost
RP_DISPLAY_NAME=go-passkey-auth
# Comma-separated allowlist; the demo client is served from the first one
RP_ORIGINS=http://localhost:8080

# Session / challenge TTLs (Go duration syntax)
SESSION_TTL=24h
CHALLENGE_TTL=5m
GUEST_TTL=1h
